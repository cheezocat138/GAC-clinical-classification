!multimodal/data/raw/rppa/.gitkeep

multimodal/data/processed/*
!multimodal/data/processed/.gitkeep

# 日志和结果 - 保留目录结构
multimodal/logs/*
!multimodal/logs/.gitkeep
multimodal/results/*
